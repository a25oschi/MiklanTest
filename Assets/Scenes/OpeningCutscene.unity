  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Miklan... I'm sorry, but I don't think I can do this anymore...\"\nLanber
    looked at Miklan with sadness in his eyes, the starry night reflected in his
    gaze. \nMiklan turned away, his heart pounding. Panic approached but he tried
    to keep calm.\n\"This isn't going to work. We're too different.\"\nLanber's words
    stung like a knife. The young man stood up and looked up at the sky for a minute,
    then closed his eyes.\n\"Goodbye, Miklan\"\nThen he walked away."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
